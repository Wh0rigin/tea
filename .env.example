# Environment override template. Use tea config for personal credentials outside the repository.
ANTHROPIC_BASE_URL=https://cf.api.fan
ANTHROPIC_MODEL=glm-5.3-flash
ANTHROPIC_API_KEY=

# Set these from the price shown for your PackyAPI token group. The agent refuses
# capped live calls when prices are missing. Without a monetary cap, prices are optional.
TEA_INPUT_PRICE_USD_PER_MTOK=
TEA_OUTPUT_PRICE_USD_PER_MTOK=
# No monetary cap by default. Set a positive amount to opt into a cap.
TEA_MAX_COST_USD=
TEA_MEMORY_POLICY=contextos
TEA_COMPACTION=auto
TEA_MEMORY_GC=auto
TEA_MAX_OUTPUT_TOKENS=4096
# Token scheduling window: conservative fallback, set to your provider's documented capacity.
TEA_CONTEXT_WINDOW_TOKENS=32768
TEA_CONTEXT_RESERVE_TOKENS=4096
# Independent request body byte guard; legacy TEA_MAX_REQUEST_INPUT_TOKENS remains an alias.
TEA_MAX_REQUEST_INPUT_BYTES=2097152
TEA_CONTEXTOS_TARGET_BYTES=32000
TEA_CAPABILITY_FEEDBACK=1
TEA_ENABLE_FILE_CREATION=1
TEA_REASONING_EFFORT=low
# GLM-5.3-Flash requires enabled thinking. Use adaptive only on compatible models.
TEA_THINKING_MODE=enabled
TEA_MAX_TOOL_CALLS=24
TEA_REQUEST_TIMEOUT_MS=90000
TEA_STORE_RAW=0
