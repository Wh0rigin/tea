{
  "name": "token-efficient-coding-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Independent terminal coding agent with auditable token accounting and benchmarks",
  "bin": {
    "tea": "./src/cli.mjs"
  },
  "scripts": {
    "tea": "node src/cli.mjs",
    "test": "node scripts/test.mjs",
    "benchmark:replay": "node src/cli.mjs benchmark run --suite core --mode replay",
    "benchmark:runtime": "node src/cli.mjs benchmark run --suite runtime-smoke --mode runtime",
    "benchmark:coding": "node scripts/test-coding-ability.mjs",
    "benchmark:pi": "node scripts/compare-pi.mjs",
    "benchmark:pi:check": "node scripts/check-pi-protocol.mjs",
    "benchmark:contextos-pi": "node scripts/compare-contextos-pi.mjs",
    "benchmark:contextos-pi:check": "node scripts/check-contextos-pi-protocol.mjs",
    "benchmark:revisions:check": "node scripts/check-revision-comparison.mjs",
    "benchmark:three-agents": "node scripts/compare-three-agents.mjs",
    "benchmark:three-agents:check": "node scripts/check-three-agent-protocol.mjs",
    "benchmark:three-agents:long-check": "node scripts/check-three-agent-protocol.mjs --long-continuation",
    "benchmark:three-agents:long-shell-check": "node scripts/check-three-agent-protocol.mjs --long-extra-shell"
  },
  "engines": {
    "node": ">=20"
  }
}
